{
  "name": "FashionHub - Order Confirmation Flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "internal/order-confirm",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "order-trigger-node",
      "name": "Order Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "order-confirmation-webhook",
      "notes": "Triggered by Node.js backend when an order is placed"
    },
    {
      "parameters": {
        "jsCode": "const order = $input.first().json;\n\nconst productList = (order.products || [])\n  .map(p => `• ${p.name} (${p.size}) x${p.qty} — Rs ${(p.price * p.qty).toLocaleString()}`)\n  .join('\\n');\n\nconst orderId = order.orderId || ('ORD-' + Date.now().toString().slice(-6));\n\nconst message =\n  `✅ *Order Confirmed!*\\n\\n` +\n  `📋 Order ID: *${orderId}*\\n` +\n  `👤 Name: ${order.customerName}\\n\\n` +\n  `🛍️ *Items:*\\n${productList}\\n\\n` +\n  `💰 Total: *Rs ${(order.total || 0).toLocaleString()}*\\n` +\n  `💳 Payment: ${order.paymentMethod}\\n` +\n  `📍 Deliver to: ${order.address}\\n\\n` +\n  `🚚 Expected delivery: 2-5 working days\\n\\n` +\n  `Thank you for shopping with *FashionHub* ❤️\\n` +\n  `Track your order: *Track ${orderId}*`;\n\nreturn [{ json: { phone: order.phone, instagramId: order.instagramId, message, orderId } }];"
      },
      "id": "order-build-message",
      "name": "Build Confirmation Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "phone-check",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "order-has-phone",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{ $json.message }}\" }\n}"
      },
      "id": "order-send-whatsapp",
      "name": "Send WhatsApp Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "instagram-check",
              "leftValue": "={{ $json.instagramId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "order-has-instagram",
      "name": "Has Instagram ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_PAGE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"recipient\": { \"id\": \"{{ $json.instagramId }}\" },\n  \"message\": { \"text\": \"{{ $json.message }}\" },\n  \"messaging_type\": \"RESPONSE\"\n}"
      },
      "id": "order-send-instagram",
      "name": "Send Instagram Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 340]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"orderId\": \"{{ $('Build Confirmation Message').first().json.orderId }}\" }",
        "options": {}
      },
      "id": "order-respond-ok",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 520]
    }
  ],
  "connections": {
    "Order Trigger": {
      "main": [[{ "node": "Build Confirmation Message", "type": "main", "index": 0 }]]
    },
    "Build Confirmation Message": {
      "main": [[{ "node": "Has Phone?", "type": "main", "index": 0 }]]
    },
    "Has Phone?": {
      "main": [
        [{ "node": "Send WhatsApp Confirmation", "type": "main", "index": 0 }],
        [{ "node": "Has Instagram ID?", "type": "main", "index": 0 }]
      ]
    },
    "Send WhatsApp Confirmation": {
      "main": [[{ "node": "Has Instagram ID?", "type": "main", "index": 0 }]]
    },
    "Has Instagram ID?": {
      "main": [
        [{ "node": "Send Instagram Confirmation", "type": "main", "index": 0 }],
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    },
    "Send Instagram Confirmation": {
      "main": [[{ "node": "Respond Success", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "fashionhub"
  },
  "id": "fashionhub-order-confirmation-flow",
  "tags": ["fashionhub", "orders", "confirmation"]
}
